# ============================================================
# Kabadiwala Connect — local environment (gitignored)
# ============================================================

# ---------- Database (required) ----------
# Active: self-contained local PostgreSQL cluster (see scripts/pg-local.*).
# Trust auth, no password, port 5433.
# This machine's network firewalls outbound TCP to all ports except 443/587,
# so the Supabase DB (5432/6543) is unreachable directly. We run a local
# TCP->WebSocket proxy (scripts/pgProxy.js) that tunnels Postgres over 443 via
# the pg-relay edge function. Prisma/pg connect to the proxy on 127.0.0.1:5433.
DATABASE_URL="postgresql://postgres:N00rSh%40%40n1234@127.0.0.1:5433/postgres?sslmode=no-verify&connection_limit=4&pool_timeout=30&connect_timeout=30"

# --- pg-relay tunnel config (used by scripts/pgProxy.js) ---
PG_PROXY_PORT=5433
PG_RELAY_URL="wss://eyvzguxlshilclzvpvqc.supabase.co/functions/v1/pg-relay"
PG_RELAY_TOKEN="43303244748ed8fb9b641687c2ea4c9adb6c8a2cec98fb47"
PG_RELAY_TARGET_HOST="db.eyvzguxlshilclzvpvqc.supabase.co"
PG_RELAY_TARGET_PORT=5432

# --- Alternatives (uncomment ONE, comment the line above) ---
# Standard local PostgreSQL install (default port 5432):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kabadiwala_connect"
#
# Supabase (project eyvzguxlshilclzvpvqc). Copy the exact "Connection Pooling"
# string from Supabase → Settings → Database, then URL-encode the password
# (the @ characters become %40). Password N00rSh@@n1234 -> N00rSh%40%40n1234:
# DATABASE_URL="postgresql://postgres.eyvzguxlshilclzvpvqc:N00rSh%40%40n1234@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ---------- Auth (required) ----------
JWT_SECRET="kabadiwala-connect-jwt-secret-sih-2024"
JWT_EXPIRES_IN="7d"

# bcrypt cost factor. 10 for development, 12 for production.
BCRYPT_ROUNDS=10

# ---------- Server ----------
PORT=3000
NODE_ENV=development

# Comma-separated allowlist of frontend origins. Empty means '*' (dev only).
CORS_ORIGIN=http://localhost:5173

# ---------- Image storage ----------
# Uploads are stored via ImageKit (keys below). Leave CLOUD_STORAGE_PROVIDER
# empty to store uploads in ./uploads locally instead.
CLOUD_STORAGE_PROVIDER=imagekit
IMAGEKIT_PUBLIC_KEY="public_cgloB2yqIGQ4IA14IaPEpM6HtOM="
IMAGEKIT_PRIVATE_KEY="private_15wJO1/CfdDOsl3g3jfZsyBUO/E="
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/rhjcwwdi3"

# S3-compatible (set CLOUD_STORAGE_PROVIDER=s3)
CLOUD_STORAGE_BUCKET=
CLOUD_STORAGE_REGION=
CLOUD_STORAGE_ACCESS_KEY=
CLOUD_STORAGE_SECRET_KEY=

# ---------- AI/ML model service (optional) ----------
# No trained model ships with this project. Disabled -> valuation uses the
# documented rule (price x weight x condition) and anomaly detection uses a
# statistical check, both clearly labelled as such in API responses.
AI_SERVICE_ENABLED=false
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_MS=8000

# Retrain is triggered once this many unapplied feedback records accumulate.
ML_FEEDBACK_THRESHOLD=50

# ---------- SMS / OTP ----------
# 'console' prints the OTP to the server log and returns it in the API response
# when NODE_ENV is not production — that is how you log in during development.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=

NOTIFICATION_ENABLED=false

# ---------- Cron schedules ----------
PRICE_TREND_CRON=0 */6 * * *
MODEL_RETRAIN_CRON=0 2 * * *
